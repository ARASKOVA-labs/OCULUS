{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCULUS",
  "version": "0.1.0",
  "identifier": "com.araskova.oculus",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../araskova-doccraft && bun run build",
    "frontendDist": "../araskova-doccraft/dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "OCULUS",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../tessdata/*"
    ]
  }
}
